NODE_ENV=development
PORT=3450
TRADING_MODE=demo
ENABLE_LIVE_TRADING=false

# Demo/Paper Exchange Credentials
DEMO_EXCHANGE_NAME=
DEMO_API_KEY=
DEMO_API_SECRET=

# Real/Live Exchange Credentials - keep secure
REAL_EXCHANGE_NAME=
REAL_API_KEY=
REAL_API_SECRET=

FUNDAMENTAL_API_KEY=
# Minimum spacing (ms) enforced between outbound CoinGecko requests, to avoid 429s when scoring a
# full watchlist in one scan cycle. CoinGecko's free/keyless tier is roughly 5-15 req/min; a paid
# FUNDAMENTAL_API_KEY tier can raise the real limit, so this can be lowered to match.
COINGECKO_MIN_INTERVAL_MS=1500
INITIAL_DEMO_BALANCE=10000
MAX_RISK_PER_TRADE_PERCENT=1
MAX_DAILY_LOSS_PERCENT=3
MAX_OPEN_POSITIONS=5
MAX_ORDER_VALUE=1000
MIN_RISK_REWARD_RATIO=1.5
DATABASE_PATH=./data/trading-bot.sqlite
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000
MAX_API_RETRIES=3

# AI Auto-Trading (Demo mode only, never Real) - how often the auto-trader re-evaluates
# assets with auto-trading enabled, in milliseconds. Minimum 30000 (30s).
AUTO_TRADE_INTERVAL_MS=300000

# Order types (Limit/Stop-Market/Stop-Limit/OCO) - how often pending-orders-watcher.js re-checks
# pending orders against live price (Demo) or the exchange's own order status (Real), in
# milliseconds. Minimum 5000 (5s).
PENDING_ORDERS_POLL_INTERVAL_MS=30000

# Futures AI Auto-Trading (KuCoin only). Unlike AUTO_TRADE_INTERVAL_MS's spot bot (Demo-only,
# hard-coded, never configurable), the futures auto-trader CAN place REAL, LEVERAGED, UNATTENDED
# trades with liquidation risk - but only when ENABLE_FUTURES_AUTO_TRADING is explicitly true here
# AND ENABLE_LIVE_TRADING is also true AND real KuCoin credentials are configured AND a given
# watchlist asset has its own real_auto_trade_enabled flag set from the UI. All four gates must
# pass; any one of them being off blocks it. This is a restart-only switch (edit this file and
# restart the server), never a UI toggle, matching ENABLE_LIVE_TRADING's own deliberately
# high-friction pattern. Leave this false unless you have specifically decided to allow it.
FUTURES_AUTO_TRADE_INTERVAL_MS=300000
ENABLE_FUTURES_AUTO_TRADING=false
# Hard cap the auto-trader clamps down to regardless of what leverage is set per-asset - always
# lower than what a human can manually choose in the Futures order form.
FUTURES_AUTO_TRADE_MAX_LEVERAGE=3
